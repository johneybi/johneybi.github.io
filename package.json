{
  "name": "blowfish_template",
  "version": "1.0.0",
  "description": "Blowfish Template",
  "main": "index.js",
  "scripts": {
    "dev": "npx tailwindcss -c ./themes/blowfish/tailwind.config.js -i ./themes/blowfish/assets/css/main.css -o ./assets/css/compiled/main.css -w --poll",
    "build": "cross-env NODE_ENV=production cd themes/blowfish && npx tailwindcss -c ./tailwind.config.js -i ./assets/css/main.css -o ../../assets/css/main.css --minify",
    "server": "hugo server --poll=700ms --bind=0.0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nunocoracao/blowfish_template.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nunocoracao/blowfish_template/issues"
  },
  "homepage": "https://github.com/nunocoracao/blowfish_template#readme",
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@iamtraction/google-translate": "^2.0.1",
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.4.21",
    "commander": "^14.0.0",
    "gsap": "^3.13.0",
    "postcss": "^8.5.6"
  },
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "^1.9.0",
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "chart.js": "^4.5.0",
    "fuse.js": "^7.1.0",
    "jquery": "^3.7.1",
    "katex": "^0.16.22",
    "lite-youtube-embed": "^0.3.3",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.11.0",
    "packery": "^3.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-go-template": "^0.0.15",
    "puppeteer": "^24.19.0",
    "rimraf": "^6.0.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.1.11",
    "tw-elements": "2.0.0",
    "typeit": "^8.8.7",
    "vendor-copy": "^3.0.1"
  }
}
